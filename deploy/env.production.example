# Modèle du fichier /opt/yeki/.env sur le VPS (jamais commité).
# Garder les apostrophes : sans elles, Docker Compose interprète les `$`.

# Ex. 51-68-1-2.sslip.io pour l'IP 51.68.1.2
DOMAIN='IP-DU-VPS.sslip.io'

# openssl rand -hex 32 (hexadécimal : la valeur entre dans une URL de connexion)
POSTGRES_PASSWORD=''

# Secrets de l'application.
SECRET_KEY=''
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
CINETPAY_API_KEY=''
CINETPAY_SITE_ID=''
CINETPAY_WEBHOOK_SECRET=''
ANTHROPIC_API_KEY=''
FIREBASE_STORAGE_BUCKET=''

# Le JSON du compte de service, sur UNE seule ligne.
FIREBASE_CREDENTIALS_JSON=''
